/out/
/exports/
/logs/
/tmp/
/temp/
/docker-data/
/volumes/
*.log
*.log.*
*.pid
*.pid.lock

# Personal Docker Compose overrides; shared compose.yaml stays tracked
/compose.override.yml
/compose.override.yaml
/docker-compose.override.yml
/docker-compose.override.yaml


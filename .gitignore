# Keep source, supplied data/*.parquet, dependency manifests, Docker configuration,
# documentation, and the final submission/ CSVs eligible for version control.
# Ignore disposable runtime exports below; do not ignore all CSV/Parquet files.

# Python environments and interpreter files
.venv/
.venv-*/
venv/
env/
ENV/
.Python
__pypackages__/
__pycache__/
*.py[cod]
*$py.class

# Python packaging and build output
build/
dist/
.eggs/
*.egg-info/
*.egg
pip-wheel-metadata/
pip-log.txt
pip-delete-this-directory.txt

# Test, type-checker, linter, and notebook caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.benchmarks/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json
junit.xml

